+static int update_peripheral_hid_indicators(struct peripheral_slot *slot,
+                                           zmk_hid_indicators_t indicators) {
+    if (slot->state != PERIPHERAL_SLOT_STATE_CONNECTED) {
+        return -ENOTCONN;
+    }
+
+    if (!slot->update_hid_indicators || bt_conn_get_security(slot->conn) < BT_SECURITY_L2) {
+        // Discovery/security completion will replay the current host state.
+        return -EAGAIN;
+    }
+
+    int err = bt_gatt_write_without_response(slot->conn, slot->update_hid_indicators,
+                                           &indicators, sizeof(indicators), true);
+    if (err) {
+        LOG_ERR("Failed to write HID indicator characteristic (err %d)", err);
+    } else {
+        LOG_DBG("Sent HID indicators to split peripheral: 0x%02x", indicators);
+    }
+    return err;
+}
+
+static void sync_peripheral_hid_indicators(struct k_work *_work) {
+    zmk_hid_indicators_t indicators = zmk_hid_indicators_get_current_profile();
+    for (int i = 0; i < ZMK_SPLIT_BLE_PERIPHERAL_COUNT; i++) {
+        update_peripheral_hid_indicators(&peripherals[i], indicators);
+    }
+}
+
+K_WORK_DEFINE(sync_peripheral_hid_indicators_work, sync_peripheral_hid_indicators);
+#endif
