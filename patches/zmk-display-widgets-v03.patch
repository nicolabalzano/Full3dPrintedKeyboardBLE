diff --git a/app/src/display/widgets/hid_indicators.c b/app/src/display/widgets/hid_indicators.c
new file mode 100644
index 00000000..8077f73b
--- /dev/null
+++ b/app/src/display/widgets/hid_indicators.c
@@ -0,0 +1,82 @@
+/*
+ * Copyright (c) 2024 The ZMK Contributors
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <zephyr/kernel.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
+
+#include <zmk/display.h>
+#include <zmk/display/widgets/hid_indicators.h>
+#include <zmk/event_manager.h>
+#include <zmk/events/hid_indicators_changed.h>
+#include <zmk/hid_indicators_types.h>
+#include <dt-bindings/zmk/hid_indicators.h>
+
+LV_FONT_DECLARE(custom_montserrat_ui_12);
+
+static sys_slist_t widgets = SYS_SLIST_STATIC_INIT(&widgets);
+
+/* Cache the last received indicator state. On the peripheral the state arrives
+ * only via the zmk_hid_indicators_changed event; there is no endpoint profile
+ * to query, so we maintain our own copy here. */
+static zmk_hid_indicators_t cached_indicators = 0;
+
+struct hid_indicators_state {
+    zmk_hid_indicators_t indicators;
+};
+
+static struct hid_indicators_state get_state(const zmk_event_t *eh) {
+    if (eh != NULL) {
+        const struct zmk_hid_indicators_changed *ev = as_zmk_hid_indicators_changed(eh);
+        if (ev != NULL) {
+            cached_indicators = ev->indicators;
+        }
+    }
+    return (struct hid_indicators_state){.indicators = cached_indicators};
+}
+
+static void set_status_text(struct zmk_widget_hid_indicators *widget,
+                            struct hid_indicators_state state) {
+    bool caps = (state.indicators & HID_INDICATOR_CAPS_LOCK) != 0;
+    lv_label_set_text(widget->label, caps ? "[A]" : "[a]");
+}
+
+static void hid_indicators_update_cb(struct hid_indicators_state state) {
+    struct zmk_widget_hid_indicators *widget;
+    SYS_SLIST_FOR_EACH_CONTAINER(&widgets, widget, node) {
+        set_status_text(widget, state);
+    }
+}
+
+ZMK_DISPLAY_WIDGET_LISTENER(widget_hid_indicators, struct hid_indicators_state,
+                            hid_indicators_update_cb, get_state)
+ZMK_SUBSCRIPTION(widget_hid_indicators, zmk_hid_indicators_changed);
+
+int zmk_widget_hid_indicators_init(struct zmk_widget_hid_indicators *widget, lv_obj_t *parent) {
+    widget->obj = lv_obj_create(parent);
+    lv_obj_set_size(widget->obj, 24, 16);
+    lv_obj_clear_flag(widget->obj, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_set_style_bg_opa(widget->obj, LV_OPA_TRANSP, LV_PART_MAIN);
+    lv_obj_set_style_border_width(widget->obj, 0, LV_PART_MAIN);
+    lv_obj_set_style_pad_all(widget->obj, 0, LV_PART_MAIN);
+
+    widget->label = lv_label_create(widget->obj);
+    lv_obj_set_style_text_font(widget->label, &custom_montserrat_ui_12, LV_PART_MAIN);
+    lv_obj_set_style_text_color(widget->label, lv_color_black(), LV_PART_MAIN);
+    lv_label_set_text(widget->label, "[a]");
+    lv_obj_center(widget->label);
+
+    sys_slist_append(&widgets, &widget->node);
+
+    set_status_text(widget, (struct hid_indicators_state){.indicators = cached_indicators});
+    widget_hid_indicators_init();
+    return 0;
+}
+
+lv_obj_t *zmk_widget_hid_indicators_obj(struct zmk_widget_hid_indicators *widget) {
+    return widget->obj;
+}
