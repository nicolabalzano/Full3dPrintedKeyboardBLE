#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include "custom.dtsi"

/*
 * Override I2C0 pinctrl: SDA=P0.20, SCL=P0.17
 */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 17)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 20)>,
                <NRF_PSEL(TWIM_SCL, 0, 17)>;
            low-power-enable;
        };
    };
};

/ {
    chosen {
        zmk,kscan = &kscan_composite;
        zephyr,display = &oled;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 0: 104 */
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 1: 011 */
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 2: 100 */
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* Row 3: 024 */
            ;

        col-gpios
            = <&gpio1 6  GPIO_ACTIVE_HIGH>  /* Col 0: più esterna (ESC, LSFT) -> 106 */
            , <&gpio0 10 GPIO_ACTIVE_HIGH>  /* Col 1: (Q, A, TAB) -> 010 */
            , <&gpio0 31 GPIO_ACTIVE_HIGH>  /* Col 2: (W, S, Z) -> 031 */
            , <&gpio1 11 GPIO_ACTIVE_HIGH>  /* Col 3: (E, D, X) -> 111 */
            , <&gpio0 29 GPIO_ACTIVE_HIGH>  /* Col 4: (R, F, C) -> 029 */
            , <&gpio0 2  GPIO_ACTIVE_HIGH>  /* Col 5: più interna (T, G, V) -> 002 */
            ;
    };

    kscan_knob_click: kscan_direct {
        wakeup-source;
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN_KNOB";
        input-gpios = <&gpio0 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        label = "KSCAN_COMPOSITE";
        rows = <4>;
        columns = <7>;

        matrix {
            kscan = <&kscan0>;
        };

        direct {
            kscan = <&kscan_knob_click>;
            row-offset = <3>;
            col-offset = <6>;
        };
    };


};

/* Enable I2C0 and add SSD1306 OLED 0.91" 128x32 display */
&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};

/ {
    chosen {
        zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
};

&left_encoder {
    status = "okay";
};
